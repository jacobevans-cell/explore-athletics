rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function isAdmin() {
      return verified() && request.auth.token.email == "jacobicusjax@gmail.com";
    }
    function athleteOwned(athleteId) {
      return verified()
        && get(/databases/$(database)/documents/athletes/$(athleteId)).data.familyUid == request.auth.uid;
    }

    match /seasons/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /teams/{teamId} {
      allow read: if true;
      allow write: if isAdmin();
      match /roster/{athleteId} { allow read, write: if isAdmin(); }
      match /events/{eventId} {
        allow read: if true;
        allow write: if isAdmin();
      }
      match /announcements/{announcementId} {
        allow read: if verified();
        allow write: if isAdmin();
      }
    }

    match /users/{uid} {
      allow read: if verified() && (request.auth.uid == uid || isAdmin());
      allow create: if verified() && request.auth.uid == uid;
      allow update: if isAdmin() || (verified() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','lastLoginAt']));
      allow delete: if isAdmin();
    }

    match /athletes/{athleteId} {
      allow read: if isAdmin() || (verified() && resource.data.familyUid == request.auth.uid);

      allow create: if isAdmin() || (verified()
        && request.resource.data.familyUid == request.auth.uid
        && request.resource.data.email == request.auth.token.email);

      allow update: if isAdmin() || (verified()
        && resource.data.familyUid == request.auth.uid
        && request.resource.data.familyUid == resource.data.familyUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstName','lastName','dob','grade','gender','phone',
          'guardianName','guardianEmail','guardianPhone',
          'emergencyName','emergencyPhone','shirtSize',
          'medicalNotes','email','updatedAt'
        ]));

      allow delete: if isAdmin();

      match /registrations/{registrationId} {
        allow read: if isAdmin() || athleteOwned(athleteId);
        allow create: if isAdmin() || (athleteOwned(athleteId)
          && request.resource.data.athleteId == athleteId
          && request.resource.data.familyUid == request.auth.uid
          && request.resource.data.status == 'submitted');
        allow update, delete: if isAdmin();
      }

      match /documents/{documentId} {
        allow read: if isAdmin() || athleteOwned(athleteId);
        allow create: if isAdmin() || (athleteOwned(athleteId)
          && request.resource.data.reviewStatus == 'pending'
          && request.resource.data.storagePath.matches('athlete-documents/' + athleteId + '/.*'));
        allow update, delete: if isAdmin();
      }

      match /payments/{paymentId} {
        allow read: if isAdmin() || athleteOwned(athleteId);
        allow create, update, delete: if isAdmin();
      }
    }

    match /athleticsSettings/{id} {
      allow read: if verified();
      allow write: if isAdmin();
    }

    match /season2SportsInterest/{id} { allow read, write: if isAdmin(); }
    match /sportsRoster/{id} { allow read, write: if isAdmin(); }

    match /{document=**} { allow read, write: if false; }
  }
}
