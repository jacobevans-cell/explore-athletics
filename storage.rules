rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function isAdmin() {
      return verified()
        && request.auth.token.email == "REPLACE_WITH_YOUR_ADMIN_GOOGLE_EMAIL";
    }

    match /athlete-documents/{uid}/{docType}/{fileName} {
      allow read: if verified() && (request.auth.uid == uid || isAdmin());
      allow create: if verified()
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('(application/pdf|image/jpeg|image/png|image/webp)');
      allow update, delete: if isAdmin();
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
